# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El .env no se sube al repositorio.

# Base de datos PostgreSQL (contenedor bioequi_postgres_v2)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bioequi_db
DB_USER=admin
DB_PASSWORD=

# Sesion de navegador de Cruz Verde (opcional; caduca en horas).
# Sin ella, Cruz Verde no se actualiza y el resto sigue normalmente.
CRUZVERDE_COOKIE=
